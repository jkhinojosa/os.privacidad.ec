# ===========================================================
# OS Privacidad — Variables de Entorno
# Copia este archivo a .env y completa los valores
# ===========================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=osprivacidad
POSTGRES_PASSWORD=changeme
POSTGRES_DB=osprivacidad
DATABASE_URL=postgresql+asyncpg://osprivacidad:changeme@db:5432/osprivacidad

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Auth ----------
JWT_SECRET=changeme-generate-a-strong-secret-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# ---------- Microsoft Graph (Outlook + OneDrive) ----------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# ---------- Proveedores de IA (todos opcionales) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
